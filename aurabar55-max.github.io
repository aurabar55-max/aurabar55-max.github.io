<style>
html{scroll-behavior:smooth}
body{margin:0;background:#0b0b0b;color:#f2ede4;font-family:-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
a{color:#e2c27a}
.w{max-width:1180px;margin:0 auto;padding:0 24px}
header{display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:center;padding-top:20px;padding-bottom:20px}
header>a{font-weight:600;font-size:20px;letter-spacing:6px;text-decoration:none}
nav{display:flex;flex-wrap:wrap;gap:8px 28px}
nav a{text-decoration:none;padding:12px 0;font-weight:500}
h1,h2,h3{text-transform:uppercase;font-weight:500;letter-spacing:3px}
.hero{text-align:center;padding:48px 24px 88px;border-bottom:1px solid #3a3122}
.hero img{width:min(420px,80%)}
.hero h1{font-size:clamp(30px,5vw,52px);margin:24px 0}
.hero p{max-width:640px;margin:0 auto 32px;font-size:18px;line-height:1.6;color:#c9c1b3}
.btn{display:inline-block;padding:14px 32px;border:1px solid #e2c27a;border-radius:999px;text-decoration:none;font-weight:600}
h2{color:#e2c27a;font-size:34px;text-align:center;margin:0 0 8px}
.sub{text-align:center;color:#a39a8b;margin:0 0 48px}
.g{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:28px}
.c{border:1px solid #3a3122;border-radius:14px;padding:28px;background:#121110}
.c h3{margin:0 0 18px;font-size:18px;font-weight:600;color:#e2c27a}
ul{list-style:none;margin:0;padding:0}
li{display:flex;gap:12px;align-items:baseline;padding:9px 0;border-bottom:1px dotted #3a3122}
li span{flex:1}
li b{font-size:13px}
li em{font-style:normal;min-width:76px;text-align:right;color:#e2c27a;font-weight:600}
section{padding-top:80px}
.c h2{text-align:left;font-size:26px;margin:0 0 20px}
.legal{max-width:860px;font-size:15px;line-height:1.7;color:#c9c1b3}
.legal h2{text-align:left;font-size:24px}
.legal h3{font-size:16px;color:#f2ede4;text-transform:none;letter-spacing:0;font-weight:600;margin:18px 0 6px}
.legal p{margin:0 0 14px}
footer{border-top:1px solid #3a3122;margin-top:80px}
footer .w{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;padding-top:28px;padding-bottom:28px;color:#a39a8b}
</style>
</head>
